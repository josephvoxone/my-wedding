# Google Sheets Integration (Optional)
# To use Google Sheets for guest management:
# 1. Create a Google Sheet with columns: slug, name, nickname, specialMessage, imagePath
# 2. Go to File > Share > Publish to web
# 3. Choose CSV format and publish
# 4. Copy the CSV URL and paste it here
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# Music File (Optional)
# Path to wedding song file in public folder
NEXT_PUBLIC_MUSIC_PATH=/music/wedding-song.mp3

# Wedding Date
NEXT_PUBLIC_WEDDING_DATE=2025-09-09

# Google Maps API Key (Optional - for embedded maps)
# Get your API key from https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp Numbers (for RSVP)
NEXT_PUBLIC_WHATSAPP_JOSEPH=6281234567890
NEXT_PUBLIC_WHATSAPP_AYU=6289876543210